// RIST Receiver with Marker Multiplexer
// Based on standard ristreceiver, adds VSF TR-06-4 Part 7 marker insertion
// Leverages working ristreceiver foundation + focused marker generation

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <getopt.h>
#include <signal.h>
#include <errno.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <pthread.h>
#include <time.h>

#include <librist/librist.h>

// Constants
#define TS_PACKET_SIZE 188
#define TS_PACKETS_PER_RTP 7
#define RTP_PAYLOADS_PER_MARKER 5
#define MARKER_PID 0x1FF0

// Global state - exactly like ristreceiver
static struct rist_ctx *ctx = NULL;
static struct rist_logging_settings logging_settings = LOGGING_SETTINGS_INITIALIZER;
static int running = 1;
static pthread_mutex_t signal_lock = PTHREAD_MUTEX_INITIALIZER;
static int signal_received = 0;

// Output socket
static int output_fd = -1;
static struct sockaddr_in output_addr;

// Marker generation state - uses RIST metadata
static uint32_t marker_sequence = 1;
static uint32_t rtp_packets_in_block = 0;
static uint32_t current_block_start_rtp_seq = 0;
static uint32_t next_block_start_rtp_seq = 0;
static uint16_t current_non_null_count = 0;
static uint16_t current_null_count = 0;
static uint32_t current_ssrc = 0;

// CRC-32 table
static uint32_t crc32_table[256];
static int crc32_table_initialized = 0;

void signal_handler(int sig) {
    pthread_mutex_lock(&signal_lock);
    signal_received = sig;
    running = 0;
    pthread_mutex_unlock(&signal_lock);
}

void init_crc32_table(void) {
    if (crc32_table_initialized) return;
    
    uint32_t polynomial = 0x04C11DB7;
    for (int i = 0; i < 256; i++) {
        uint32_t crc = i << 24;
        for (int j = 0; j < 8; j++) {
            if (crc & 0x80000000) {
                crc = (crc << 1) ^ polynomial;
            } else {
                crc <<= 1;
            }
        }
        crc32_table[i] = crc;
    }
    crc32_table_initialized = 1;
}

uint32_t calculate_crc32(const uint8_t *data, int length) {
    uint32_t crc = 0xFFFFFFFF;
    for (int i = 0; i < length; i++) {
        uint8_t index = ((crc >> 24) ^ data[i]) & 0xFF;
        crc = (crc << 8) ^ crc32_table[index];
    }
    return crc;
}

int is_null_packet(const uint8_t *ts_packet) {
    uint16_t pid = ((ts_packet[1] & 0x1F) << 8) | ts_packet[2];
    return (pid == 0x1FFF);
}

void generate_metadata_marker(uint8_t *marker_packet) {
    memset(marker_packet, 0, TS_PACKET_SIZE);
    
    // TS packet header for PID 0x1FF0
    marker_packet[0] = 0x47; // sync byte
    marker_packet[1] = 0x5F; // TEI=0, PUSI=1, Priority=0, PID high 5 bits
    marker_packet[2] = 0xF0; // PID low 8 bits (0x1FF0)
    marker_packet[3] = 0x10; // Scrambling=00, AFC=01, CC=0000
    
    // Pointer field
    marker_packet[4] = 0x00;
    
    // Private section
    uint8_t *private_section = &marker_packet[5];
    int section_pos = 0;
    
    // Private section header (VSF TR-06-4 Part 7 format)
    private_section[section_pos++] = 0xBF; // table_id = 0xBF
    private_section[section_pos++] = 0x00; // section_syntax_indicator(0) + private_indicator(0)
    private_section[section_pos++] = 0x14; // private_section_length = 20
    
    // marker_sequence_number (32 bits, big endian)
    private_section[section_pos++] = (marker_sequence >> 24) & 0xFF;
    private_section[section_pos++] = (marker_sequence >> 16) & 0xFF;
    private_section[section_pos++] = (marker_sequence >> 8) & 0xFF;
    private_section[section_pos++] = marker_sequence & 0xFF;
    
    // non_null_count (16 bits, big endian)
    private_section[section_pos++] = (current_non_null_count >> 8) & 0xFF;
    private_section[section_pos++] = current_non_null_count & 0xFF;
    
    // null_count (16 bits, big endian)
    private_section[section_pos++] = (current_null_count >> 8) & 0xFF;
    private_section[section_pos++] = current_null_count & 0xFF;
    
    // rtp_sequence_start_msb (16 bits) - 0 for 16-bit sequences
    private_section[section_pos++] = 0x00;
    private_section[section_pos++] = 0x00;
    
    // rtp_sequence_start_lsb (16 bits, big endian) - from RIST metadata
    private_section[section_pos++] = (current_block_start_rtp_seq >> 8) & 0xFF;
    private_section[section_pos++] = current_block_start_rtp_seq & 0xFF;
    
    // rtp_sequence_next_msb (16 bits) - 0 for 16-bit sequences
    private_section[section_pos++] = 0x00;
    private_section[section_pos++] = 0x00;
    
    // rtp_sequence_next_lsb (16 bits, big endian) - from RIST metadata
    private_section[section_pos++] = (next_block_start_rtp_seq >> 8) & 0xFF;
    private_section[section_pos++] = next_block_start_rtp_seq & 0xFF;
    
    // source_ssrc (32 bits, big endian) - from RIST metadata
    private_section[section_pos++] = (current_ssrc >> 24) & 0xFF;
    private_section[section_pos++] = (current_ssrc >> 16) & 0xFF;
    private_section[section_pos++] = (current_ssrc >> 8) & 0xFF;
    private_section[section_pos++] = current_ssrc & 0xFF;
    
    // Calculate and insert CRC-32
    uint32_t crc = calculate_crc32(private_section, section_pos);
    private_section[section_pos++] = (crc >> 24) & 0xFF;
    private_section[section_pos++] = (crc >> 16) & 0xFF;
    private_section[section_pos++] = (crc >> 8) & 0xFF;
    private_section[section_pos++] = crc & 0xFF;
    
    // Fill remainder with stuffing bytes
    int remaining = TS_PACKET_SIZE - 5 - section_pos;
    if (remaining > 0) {
        memset(&private_section[section_pos], 0xFF, remaining);
    }
    
    printf("[MARKER] Generated: seq=%u, non_null=%u, null=%u, start_rtp=%u, next_rtp=%u, ssrc=0x%08X\n",
           marker_sequence, current_non_null_count, current_null_count,
           current_block_start_rtp_seq, next_block_start_rtp_seq, current_ssrc);
}

// Main callback - based on ristreceiver cb_recv but with marker insertion
int cb_recv(void *arg, struct rist_data_block *b) {
    (void)arg;
    
    if (!b || !b->payload || b->payload_len <= 0) {
        return -1;
    }
    
    // Extract RIST metadata (same as ristreceiver would see)
    uint32_t rtp_sequence = (uint32_t)b->seq;
    uint32_t ssrc = b->flow_id;
    
    // Update current SSRC
    current_ssrc = ssrc;
    
    // Track block boundaries
    if (rtp_packets_in_block == 0) {
        current_block_start_rtp_seq = rtp_sequence;
    }
    
    // Count packets in current TS payload for marker generation
    const uint8_t *ts_data = (const uint8_t *)b->payload;
    int ts_packets = b->payload_len / TS_PACKET_SIZE;
    
    for (int i = 0; i < ts_packets; i++) {
        const uint8_t *ts_packet = ts_data + (i * TS_PACKET_SIZE);
        if (ts_packet[0] == 0x47) {  // Valid sync byte
            if (is_null_packet(ts_packet)) {
                current_null_count++;
            } else {
                current_non_null_count++;
            }
        }
    }
    
    // Forward the original payload exactly as ristreceiver would
    ssize_t sent = sendto(output_fd, b->payload, b->payload_len, 0,
                         (struct sockaddr*)&output_addr, sizeof(output_addr));
    
    if (sent != (ssize_t)b->payload_len) {
        printf("[UDP] Send error: %s\n", strerror(errno));
    }
    
    // Update block tracking
    rtp_packets_in_block++;
    next_block_start_rtp_seq = rtp_sequence + 1;
    
    // Check if it's time to insert a marker
    if (rtp_packets_in_block >= RTP_PAYLOADS_PER_MARKER) {
        uint8_t marker_packet[TS_PACKET_SIZE];
        generate_metadata_marker(marker_packet);
        
        // Send marker as separate UDP packet (maintains TS packet boundaries)
        ssize_t marker_sent = sendto(output_fd, marker_packet, TS_PACKET_SIZE, 0,
                                   (struct sockaddr*)&output_addr, sizeof(output_addr));
        
        if (marker_sent == TS_PACKET_SIZE) {
            printf("[MARKER] Sent marker packet (%d bytes)\n", TS_PACKET_SIZE);
        } else {
            printf("[MARKER] Send error: %s\n", strerror(errno));
        }
        
        // Reset for next block
        marker_sequence++;
        rtp_packets_in_block = 0;
        current_non_null_count = 0;
        current_null_count = 0;
        current_block_start_rtp_seq = next_block_start_rtp_seq;
    }
    
    return 0;
}

int setup_output_socket(const char *ip, int port) {
    output_fd = socket(AF_INET, SOCK_DGRAM, 0);
    if (output_fd < 0) {
        perror("socket");
        return -1;
    }

    // Configure multicast if needed
    struct in_addr addr;
    inet_pton(AF_INET, ip, &addr);
    if (IN_MULTICAST(ntohl(addr.s_addr))) {
        unsigned char ttl = 1;
        setsockopt(output_fd, IPPROTO_IP, IP_MULTICAST_TTL, &ttl, sizeof(ttl));
        printf("Configured multicast output\n");
    }

    memset(&output_addr, 0, sizeof(output_addr));
    output_addr.sin_family = AF_INET;
    output_addr.sin_port = htons(port);
    inet_pton(AF_INET, ip, &output_addr.sin_addr);

    printf("Output UDP: %s:%d\n", ip, port);
    return 0;
}

void usage(char *prog) {
    printf("Usage: %s -i <rist_input_url> -o <udp_output_url>\n", prog);
    printf("Example: %s -i rist://192.168.110.107:5554 -o udp://239.6.6.6:6000\n", prog);
    printf("\nRIST Receiver with VSF TR-06-4 Part 7 Marker Insertion\n");
    printf("- Uses proven ristreceiver foundation\n");
    printf("- Extracts RTP metadata from RIST data blocks\n");
    printf("- Inserts compliant metadata markers every 5 RTP payloads\n");
    printf("- Maintains proper UDP packet boundaries\n");
}

int main(int argc, char *argv[]) {
    char *inputurl = NULL;
    char *outputurl = NULL;
    int c;
    
    init_crc32_table();
    
    signal(SIGINT, signal_handler);
    signal(SIGTERM, signal_handler);
    signal(SIGPIPE, signal_handler);
    
    // Parse command line - same as ristreceiver
    while ((c = getopt(argc, argv, "i:o:v:h")) != -1) {
        switch (c) {
            case 'i':
                inputurl = strdup(optarg);
                break;
            case 'o':
                outputurl = strdup(optarg);
                break;
            case 'v':
                logging_settings.log_level = atoi(optarg);
                break;
            case 'h':
            default:
                usage(argv[0]);
                return 1;
        }
    }
    
    if (!inputurl || !outputurl) {
        usage(argv[0]);
        return 1;
    }
    
    // Parse output URL
    char output_ip[256] = {0};
    int output_port = 0;
    if (sscanf(outputurl, "udp://%255[^:]:%d", output_ip, &output_port) != 2) {
        printf("ERROR: Could not parse output URL: %s\n", outputurl);
        return 1;
    }
    
    // Setup logging - same as ristreceiver
    struct rist_logging_settings *log_ptr = &logging_settings;
    if (rist_logging_set(&log_ptr, RIST_LOG_INFO, NULL, NULL, NULL, stderr) != 0) {
        fprintf(stderr, "Failed to setup logging!\n");
        return 1;
    }
    
    printf("VSF TR-06-4 Part 7 RIST Receiver with Marker Multiplexer\n");
    printf("libRIST version: %s API version: %s\n", librist_version(), librist_api_version());
    
    // Setup output socket
    if (setup_output_socket(output_ip, output_port) != 0) {
        return 1;
    }
    
    // Create RIST receiver - same as ristreceiver
    if (rist_receiver_create(&ctx, RIST_PROFILE_MAIN, &logging_settings) != 0) {
        printf("ERROR: Could not create RIST receiver context\n");
        return 1;
    }
    
    // Parse input URL and create peer - same as ristreceiver
    struct rist_peer_config *peer_config = NULL;
    if (rist_parse_address2(inputurl, &peer_config) != 0) {
        printf("ERROR: Could not parse peer options\n");
        rist_destroy(ctx);
        return 1;
    }
    
    struct rist_peer *peer = NULL;
    if (rist_peer_create(ctx, &peer, peer_config) != 0) {
        printf("ERROR: Could not add peer connector\n");
        rist_peer_config_free2(&peer_config);
        rist_destroy(ctx);
        return 1;
    }
    
    rist_peer_config_free2(&peer_config);
    
    // Start RIST - same as ristreceiver
    if (rist_start(ctx) != 0) {
        printf("ERROR: Could not start RIST receiver\n");
        rist_destroy(ctx);
        return 1;
    }
    
    printf("RIST receiver started successfully\n");
    printf("Input: %s\n", inputurl);
    printf("Output: %s (original TS + markers)\n", outputurl);
    printf("Marker insertion: Every %d RTP payloads\n", RTP_PAYLOADS_PER_MARKER);
    printf("Ready to receive and multiplex...\n\n");
    
    // Main receive loop - same as ristreceiver
    while (running) {
        struct rist_data_block *b = NULL;
        int queue_size = rist_receiver_data_read2(ctx, &b, 5);
        
        if (queue_size > 0) {
            if (queue_size % 10 == 0 || queue_size > 50) {
                uint32_t flow_id = b ? b->flow_id : 0;
                printf("WARNING: Falling behind on data read: count %d, flow id %u\n", 
                       queue_size, flow_id);
            }
            if (b && b->payload) {
                cb_recv(NULL, b);
                rist_receiver_data_block_free2(&b);
            }
        }
        
        pthread_mutex_lock(&signal_lock);
        if (signal_received) {
            printf("\nSignal %d received\n", signal_received);
            break;
        }
        pthread_mutex_unlock(&signal_lock);
    }
    
    printf("\nShutting down\n");
    printf("Final marker sequence: %u\n", marker_sequence - 1);
    
    // Cleanup - same as ristreceiver
    rist_destroy(ctx);
    
    if (output_fd >= 0) {
        close(output_fd);
    }
    
    if (inputurl) free(inputurl);
    if (outputurl) free(outputurl);
    
    return 0;
}