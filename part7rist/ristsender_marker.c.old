/* Modified ristsender.c for VSF TR-06-4 Part 7 marker processing
 * Strips markers from marked TS input and uses marker info to control RTP sequences
 * Based on standard libRIST ristsender
 *
 * SPDX-License-Identifier: BSD-2-Clause
 */

#include <librist/librist.h>
#include <librist/udpsocket.h>
#include <stdint.h>
#include <errno.h>
#include <fcntl.h>
#include <stdio.h>
#include <string.h>
#include <sys/types.h>
#include <getopt.h>
#include <stdbool.h>
#include <signal.h>
#include <stdatomic.h>
#include <pthread.h>
#include <unistd.h>
#include <stdlib.h>
#include <inttypes.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <time.h>
#include <sys/time.h>

#define RIST_MARK_UNUSED(unused_param) ((void)(unused_param))
#define RISTSENDER_VERSION "30-Part7-Fixed"
#define MAX_INPUT_COUNT 20
#define MAX_OUTPUT_COUNT 20

// VSF TR-06-4 Part 7 Constants
#define TS_PACKET_SIZE 188
#define TS_PACKETS_PER_RTP 7
#define MARKER_PID 0x1FF0
#define MAX_BLOCK_RTP_PAYLOADS 200
#define MAX_BLOCK_TS_PACKETS (MAX_BLOCK_RTP_PAYLOADS * TS_PACKETS_PER_RTP)

static int signalReceived = 0;
static int peer_connected_count = 0;
static struct rist_logging_settings logging_settings = LOGGING_SETTINGS_INITIALIZER;

struct rist_ctx_wrap {
	struct rist_ctx *ctx;
	uintptr_t id;
	bool sender;
};

// Marker data structure
struct marker_data {
    uint32_t marker_sequence;
    uint16_t non_null_count;
    uint16_t null_count;
    uint32_t rtp_sequence_start;
    uint32_t rtp_sequence_next;
    uint32_t source_ssrc;
    uint32_t crc32;
};

// Peer arguments structure
struct rist_peer_args {
	char *token;
	enum rist_profile profile;
	enum rist_log_level loglevel;
	char *shared_secret;
	int encryption_type;
	uint32_t recovery_maxbitrate;
	uint32_t recovery_maxbitrate_return;
	uint32_t recovery_length_min;
	uint32_t recovery_length_max;
	uint32_t recovery_reorder_buffer;
	uint32_t recovery_rtt_min;
	uint32_t recovery_rtt_max;
	uint32_t buffer_size;
	uint32_t statsinterval;
	uint32_t stream_id;
	size_t peer_config_count;
	int compression_type;
};

struct rist_callback_object {
	int sd;
	struct evsocket_ctx *evctx;
	struct rist_ctx_wrap *receiver_ctx;
	struct rist_ctx_wrap *sender_ctx;
	struct rist_udp_config *udp_config;
	uint8_t recv[1500];
	
	// VSF TR-06-4 Part 7 block collection state
	uint8_t *block_buffer;              // Buffer for full block between markers
	size_t block_buffer_capacity;       // Allocated capacity
	size_t block_ts_count;              // Current number of TS packets in buffer
	uint16_t block_non_null_count;      // Non-NULL count for current block
	uint16_t block_null_count;          // NULL count for current block
	
	// Marker tracking
	bool first_marker_seen;             // Have we seen the first marker?
	bool sender_started;                // Has sender been started with correct SSRC?
	uint32_t pending_rtp_seq_start;     // RTP seq for current buffered block
	uint32_t pending_ssrc;              // SSRC for current buffered block
	
	// Statistics
	uint64_t markers_processed;
	uint64_t blocks_validated;
	uint64_t blocks_dropped;
	uint64_t blocks_sent;
	uint64_t rtp_packets_sent;
};

static struct rist_callback_object callback_object[MAX_INPUT_COUNT];
static struct evsocket_event *event[MAX_INPUT_COUNT];
static bool thread_started[MAX_INPUT_COUNT + 1];
static pthread_t thread_main_loop[MAX_INPUT_COUNT + 1];

// Forward declarations
static struct rist_ctx_wrap *configure_rist_output_context(char* outputurl, struct rist_peer_args *peer_args, const struct rist_udp_config *udp_config, bool npd, enum rist_profile profile);
static struct rist_peer *setup_rist_peer(struct rist_ctx_wrap *ctx_wrap, struct rist_peer_args *peer_args);
static int cb_auth_connect(void *arg, const char* connecting_ip, uint16_t connecting_port, const char* local_ip, uint16_t local_port, struct rist_peer *peer);
static int cb_auth_disconnect(void *arg, struct rist_peer *peer);
static void connection_status_callback(void *arg, struct rist_peer *peer, enum rist_connection_status peer_connection_status);

// High precision timestamp function (returns microseconds since epoch)
static uint64_t get_timestamp_us(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (uint64_t)ts.tv_sec * 1000000ULL + (uint64_t)ts.tv_nsec / 1000ULL;
}

static int is_marker_packet(const uint8_t *ts_packet) {
    if (ts_packet[0] != 0x47) return 0;
    uint16_t pid = ((ts_packet[1] & 0x1F) << 8) | ts_packet[2];
    return (pid == MARKER_PID);
}

static int is_null_packet(const uint8_t *ts_packet) {
    if (ts_packet[0] != 0x47) return 0;
    uint16_t pid = ((ts_packet[1] & 0x1F) << 8) | ts_packet[2];
    return (pid == 0x1FFF);
}

static int parse_marker_packet(const uint8_t *ts_packet, struct marker_data *marker) {
    // Verify sync byte
    if (ts_packet[0] != 0x47) {
        return -1;
    }
    
    // Check PUSI flag for start of section
    if (!(ts_packet[1] & 0x40)) {
        return -1;
    }
    
    // Get pointer field
    uint8_t pointer = ts_packet[4];
    if (pointer != 0) {
        return -1;
    }
    
    // Parse private section starting at byte 5
    const uint8_t *section = &ts_packet[5];
    
    // Verify table_id
    if (section[0] != 0xBF) {
        return -1;
    }
    
    // Verify section syntax and length
    if ((section[1] & 0xF0) != 0x00 || section[2] != 20) {
        return -1;
    }
    
    // Extract marker data (all big endian)
    marker->marker_sequence = (section[3] << 24) | (section[4] << 16) | (section[5] << 8) | section[6];
    marker->non_null_count = (section[7] << 8) | section[8];
    marker->null_count = (section[9] << 8) | section[10];
    // Skip MSB fields (bytes 11-12) - not used for 16-bit sequences
    marker->rtp_sequence_start = (section[13] << 8) | section[14];
    // Skip MSB fields (bytes 15-16)
    marker->rtp_sequence_next = (section[17] << 8) | section[18];
    marker->source_ssrc = (section[19] << 24) | (section[20] << 16) | (section[21] << 8) | section[22];
    marker->crc32 = (section[23] << 24) | (section[24] << 16) | (section[25] << 8) | section[26];
    
    return 0;
}

static void send_block_to_rist(struct rist_callback_object *callback_object) {
    if (!peer_connected_count) {
        rist_log(&logging_settings, RIST_LOG_WARN, "No peers connected, skipping block send\n");
        return;
    }
    
    size_t total_packets = callback_object->block_ts_count;
    size_t num_rtp_payloads = total_packets / TS_PACKETS_PER_RTP;
    
    rist_log(&logging_settings, RIST_LOG_INFO, 
             "Sending block with CBR pacing: %zu TS packets, %zu RTP payloads, start_seq=%u, SSRC=0x%08X\n",
             total_packets, num_rtp_payloads, 
             callback_object->pending_rtp_seq_start, callback_object->pending_ssrc);
    
    // Calculate CBR pacing - assume standard ~180 packets/second (~5.56ms per RTP payload)
    // This matches typical broadcast transport stream timing
    const uint64_t PACKET_INTERVAL_US = 5560; // 5.56ms in microseconds
    
    uint32_t current_rtp_seq = callback_object->pending_rtp_seq_start;
    uint64_t base_time = get_timestamp_us();
    
    for (size_t i = 0; i < num_rtp_payloads; i++) {
        // Calculate target send time for this packet
        uint64_t target_time = base_time + (i * PACKET_INTERVAL_US);
        
        // Wait until target time (maintain CBR spacing)
        uint64_t current_time = get_timestamp_us();
        if (current_time < target_time) {
            uint64_t wait_us = target_time - current_time;
            if (wait_us > 0 && wait_us < 50000) { // Sanity check: wait max 50ms
                usleep((useconds_t)wait_us);
            }
        }
        
        struct rist_data_block data_block = {0};
        data_block.payload = &callback_object->block_buffer[i * TS_PACKETS_PER_RTP * TS_PACKET_SIZE];
        data_block.payload_len = TS_PACKETS_PER_RTP * TS_PACKET_SIZE;
        data_block.seq = current_rtp_seq;
        data_block.flags = RIST_DATA_FLAGS_USE_SEQ;
        data_block.ts_ntp = 0;
        data_block.flow_id = callback_object->pending_ssrc;
        
        int ret = rist_sender_data_write(callback_object->sender_ctx->ctx, &data_block);
        if (ret < 0) {
            rist_log(&logging_settings, RIST_LOG_ERROR, 
                     "Failed to send RTP payload (seq=%u): %d\n", current_rtp_seq, ret);
        } else {
            callback_object->rtp_packets_sent++;
        }
        
        current_rtp_seq++;
    }
    
    callback_object->blocks_sent++;
}

static void process_marker(struct rist_callback_object *callback_object, const uint8_t *marker_packet) {
    struct marker_data marker;
    
    if (parse_marker_packet(marker_packet, &marker) != 0) {
        rist_log(&logging_settings, RIST_LOG_WARN, "Failed to parse marker packet\n");
        return;
    }
    
    callback_object->markers_processed++;
    
    rist_log(&logging_settings, RIST_LOG_INFO, 
             "Marker #%u: non_null=%u, null=%u, rtp_start=%u, rtp_next=%u, SSRC=0x%08X\n",
             marker.marker_sequence, marker.non_null_count, marker.null_count,
             marker.rtp_sequence_start, marker.rtp_sequence_next, marker.source_ssrc);
    
    // First marker - extract SSRC and start sender, but ignore the block data
    if (!callback_object->first_marker_seen) {
        callback_object->first_marker_seen = true;
        callback_object->pending_ssrc = marker.source_ssrc;
        
        rist_log(&logging_settings, RIST_LOG_INFO, 
                 "First marker seen (seq=%u), extracted SSRC=0x%08X, starting sender...\n", 
                 marker.marker_sequence, marker.source_ssrc);
        
        // Set the SSRC and start sender
        if (!callback_object->sender_started) {
            if (rist_sender_flow_id_set(callback_object->sender_ctx->ctx, marker.source_ssrc) != 0) {
                rist_log(&logging_settings, RIST_LOG_ERROR, 
                         "Failed to set sender flow_id to 0x%08X\n", marker.source_ssrc);
            } else {
                rist_log(&logging_settings, RIST_LOG_INFO, 
                         "Successfully set sender SSRC to 0x%08X\n", marker.source_ssrc);
            }
            
            if (rist_start(callback_object->sender_ctx->ctx) == -1) {
                rist_log(&logging_settings, RIST_LOG_ERROR, "Could not start rist sender\n");
            } else {
                callback_object->sender_started = true;
                rist_log(&logging_settings, RIST_LOG_INFO, 
                         "RIST sender started successfully with SSRC=0x%08X\n",
                         marker.source_ssrc);
            }
        }
        
        // Ignore this marker's block description - we don't have a complete block yet
        rist_log(&logging_settings, RIST_LOG_INFO, 
                 "Ignoring first marker block description, starting fresh data collection\n");
        return;
    }
    
    // All subsequent markers - validate and send the block we collected since the last marker
    if (callback_object->block_ts_count > 0) {
        // CRITICAL FIX: Use rtp_sequence_start (current block) not rtp_sequence_next (next block)
        callback_object->pending_rtp_seq_start = marker.rtp_sequence_start;
        callback_object->pending_ssrc = marker.source_ssrc;
        
        // Validate the block we just collected against this marker's description
        size_t total_ts_packets = callback_object->block_non_null_count + callback_object->block_null_count;
        bool counts_match = (callback_object->block_non_null_count == marker.non_null_count &&
                            callback_object->block_null_count == marker.null_count);
        bool aligned = (total_ts_packets % TS_PACKETS_PER_RTP == 0);
        bool buffer_match = (callback_object->block_ts_count == total_ts_packets);
        
        rist_log(&logging_settings, RIST_LOG_INFO, 
                 "Block validation: collected non_null=%u null=%u total=%zu buffered=%zu\n",
                 callback_object->block_non_null_count, callback_object->block_null_count,
                 total_ts_packets, callback_object->block_ts_count);
        
        if (counts_match && aligned && buffer_match) {
            rist_log(&logging_settings, RIST_LOG_INFO, 
                     "Block VALID - sending to RIST with seq_start=%u\n",
                     callback_object->pending_rtp_seq_start);
            send_block_to_rist(callback_object);
            callback_object->blocks_validated++;
        } else {
            rist_log(&logging_settings, RIST_LOG_WARN, 
                     "Block INVALID - dropping (counts_match=%d, aligned=%d, buffer_match=%d)\n",
                     counts_match, aligned, buffer_match);
            callback_object->blocks_dropped++;
        }
    } else {
        rist_log(&logging_settings, RIST_LOG_INFO, 
                 "No data collected yet, starting data collection for next block\n");
    }
    
    // Reset for next block collection
    callback_object->block_ts_count = 0;
    callback_object->block_non_null_count = 0;
    callback_object->block_null_count = 0;
}

static void buffer_ts_packet(struct rist_callback_object *callback_object, const uint8_t *ts_packet) {
    // Check if we have space
    if (callback_object->block_ts_count >= MAX_BLOCK_TS_PACKETS) {
        rist_log(&logging_settings, RIST_LOG_ERROR, 
                 "Block buffer overflow! Dropping packet. Current count: %zu\n",
                 callback_object->block_ts_count);
        return;
    }
    
    // Copy packet to buffer
    memcpy(&callback_object->block_buffer[callback_object->block_ts_count * TS_PACKET_SIZE],
           ts_packet, TS_PACKET_SIZE);
    callback_object->block_ts_count++;
    
    // Update counts
    if (is_null_packet(ts_packet)) {
        callback_object->block_null_count++;
    } else {
        callback_object->block_non_null_count++;
    }
}

static void input_udp_recv(struct evsocket_ctx *evctx, int fd, short revents, void *arg)
{
    struct rist_callback_object *callback_object = (void *) arg;
    RIST_MARK_UNUSED(evctx);
    RIST_MARK_UNUSED(revents);
    RIST_MARK_UNUSED(fd);

    ssize_t recv_bufsize = -1;
    struct sockaddr_in addr4 = {0};
    struct sockaddr_in6 addr6 = {0};
    uint8_t *recv_buf = callback_object->recv;
    socklen_t addrlen = 0;

    uint16_t address_family = (uint16_t)callback_object->udp_config->address_family;
    if (address_family == AF_INET6) {
        addrlen = sizeof(struct sockaddr_in6);
        recv_bufsize = udpsocket_recvfrom(callback_object->sd, recv_buf, 1500, MSG_DONTWAIT, (struct sockaddr *) &addr6, &addrlen);
    } else {
        addrlen = sizeof(struct sockaddr_in);
        recv_bufsize = udpsocket_recvfrom(callback_object->sd, recv_buf, 1500, MSG_DONTWAIT, (struct sockaddr *) &addr4, &addrlen);
    }

    if (recv_bufsize > 0) {
        // Process received data packet by packet
        int offset = 0;
        
        while (offset + TS_PACKET_SIZE <= recv_bufsize) {
            uint8_t *ts_packet = &recv_buf[offset];
            
            // Verify sync byte
            if (ts_packet[0] != 0x47) {
                rist_log(&logging_settings, RIST_LOG_WARN, 
                         "Invalid sync byte at offset %d: 0x%02X\n", offset, ts_packet[0]);
                offset += TS_PACKET_SIZE;
                continue;
            }
            
            // Check if this is a marker packet
            if (is_marker_packet(ts_packet)) {
                process_marker(callback_object, ts_packet);
            } else {
                // Regular TS packet - buffer it if we've seen first marker
                if (callback_object->first_marker_seen) {
                    buffer_ts_packet(callback_object, ts_packet);
                } else {
                    // Discard packets before first marker
                    rist_log(&logging_settings, RIST_LOG_DEBUG, 
                             "Discarding packet before first marker\n");
                }
            }
            
            offset += TS_PACKET_SIZE;
        }
        
        if (offset < recv_bufsize) {
            rist_log(&logging_settings, RIST_LOG_WARN, 
                     "%zd bytes remaining (not multiple of %d)\n", 
                     recv_bufsize - offset, TS_PACKET_SIZE);
        }
    } else {
        if (errno != EWOULDBLOCK) {
            rist_log(&logging_settings, RIST_LOG_ERROR, 
                     "Input receive failed: errno=%d, ret=%zd, socket=%d\n", 
                     errno, recv_bufsize, callback_object->sd);
        }
    }
}

static void input_udp_sockerr(struct evsocket_ctx *evctx, int fd, short revents, void *arg)
{
	struct rist_callback_object *callback_object = (void *) arg;
	RIST_MARK_UNUSED(evctx);
	RIST_MARK_UNUSED(revents);
	RIST_MARK_UNUSED(fd);
	rist_log(&logging_settings, RIST_LOG_ERROR, "Socket error on sd=%d, stream-id=%d !\n", callback_object->sd, callback_object->udp_config->stream_id);
}

static char help_str[] = "librist, VSF TR-06-4 Part 7 RIST Sender (strips markers), Supports Main and Simple Profiles";

static void usage(char *cmd)
{
	rist_log(&logging_settings, RIST_LOG_INFO, "%s\n%s version %s libRIST library: %s API version: %s\n", cmd, help_str, RISTSENDER_VERSION, librist_version(), librist_api_version());
	exit(1);
}

static void connection_status_callback(void *arg, struct rist_peer *peer, enum rist_connection_status peer_connection_status)
{
	(void)arg;
	if (peer_connection_status == RIST_CONNECTION_ESTABLISHED || peer_connection_status == RIST_CLIENT_CONNECTED)
		peer_connected_count++;
	else
		peer_connected_count--;
	rist_log(&logging_settings, RIST_LOG_INFO,"Connection Status changed for Peer %"PRIu64", new status is %d, peer connected count is %d\n",
				(uint64_t)peer, peer_connection_status, peer_connected_count);
}

static int cb_auth_connect(void *arg, const char* connecting_ip, uint16_t connecting_port, const char* local_ip, uint16_t local_port, struct rist_peer *peer)
{
	struct rist_ctx_wrap *w = (struct rist_ctx_wrap *)arg;
	RIST_MARK_UNUSED(connecting_ip);
	RIST_MARK_UNUSED(connecting_port);
	RIST_MARK_UNUSED(local_ip);
	RIST_MARK_UNUSED(local_port);
	RIST_MARK_UNUSED(peer);
	rist_log(&logging_settings, RIST_LOG_INFO,"Auth request from %s:%d for peer %"PRIu64", local %s:%d\n", connecting_ip, connecting_port, (uint64_t)peer, local_ip, local_port);
	return 0;
}

static int cb_auth_disconnect(void *arg, struct rist_peer *peer)
{
	struct rist_ctx_wrap *w = (struct rist_ctx_wrap *)arg;
	RIST_MARK_UNUSED(peer);
	rist_log(&logging_settings, RIST_LOG_INFO,"Peer %" PRIu64 " has disconnected\n", (uint64_t)peer);
	return 0;
}

static void intHandler(int signal) {
	if (signal == SIGINT) {
		rist_log(&logging_settings, RIST_LOG_INFO, "Signal received (%d), shutting down\n", signal);
	}
	signalReceived = signal;
}

static struct rist_peer *setup_rist_peer(struct rist_ctx_wrap *ctx_wrap, struct rist_peer_args *peer_args)
{
	struct rist_peer_config *peer_config_link = NULL;
	if (rist_parse_address2(peer_args->token, &peer_config_link))
	{
		rist_log(&logging_settings, RIST_LOG_ERROR, "Could not parse address %s\n", peer_args->token);
		goto cleanup;
	}

	// Simple profile does not handle encryption
	if (peer_args->profile != RIST_PROFILE_SIMPLE && peer_config_link)
	{
		if (peer_args->shared_secret && strlen(peer_args->shared_secret) > 0)
		{
			peer_config_link->secret[0] = 0;
			strncpy(peer_config_link->secret, peer_args->shared_secret, RIST_MAX_STRING_SHORT -1);
			if (peer_args->encryption_type)
				peer_config_link->key_size = peer_args->encryption_type;
			else
				peer_config_link->key_size = 128;
		}
		peer_config_link->recovery_mode = RIST_RECOVERY_MODE_TIME;
		peer_config_link->recovery_maxbitrate = peer_args->recovery_maxbitrate;
		peer_config_link->recovery_maxbitrate_return = peer_args->recovery_maxbitrate_return;
		peer_config_link->recovery_length_min = peer_args->recovery_length_min;
		peer_config_link->recovery_length_max = peer_args->recovery_length_max;
		peer_config_link->recovery_reorder_buffer = peer_args->recovery_reorder_buffer;
		peer_config_link->recovery_rtt_min = peer_args->recovery_rtt_min;
		peer_config_link->recovery_rtt_max = peer_args->recovery_rtt_max;
	}

	struct rist_peer *peer;
	if (rist_peer_create(ctx_wrap->ctx, &peer, peer_config_link) == -1) {
		rist_log(&logging_settings, RIST_LOG_ERROR, "Could not add peer connector to %s\n", peer_args->token);
		goto cleanup;
	}

	rist_peer_config_free2(&peer_config_link);
	return peer;

cleanup:
	rist_peer_config_free2(&peer_config_link);
	return NULL;
}

static void *input_loop(void *arg)
{
	struct rist_callback_object *callback_object = (void *) arg;
	// This is my main loop (one thread per receiver)
	while (!signalReceived) {
		if (callback_object->receiver_ctx)
		{
			// RIST receiver
			struct rist_data_block *b = NULL;
			int queue_size = rist_receiver_data_read2(callback_object->receiver_ctx->ctx, &b, 5);
			if (queue_size > 0) {
				if (queue_size % 10 == 0 || queue_size > 50)
					rist_log(&logging_settings, RIST_LOG_WARN, "Falling behind on rist_receiver_data_read: %d\n", queue_size);
				if (b && b->payload) {
					if (peer_connected_count) {
						int w = rist_sender_data_write(callback_object->sender_ctx->ctx, b);
						// TODO: report error?
						(void) w;
					}
					rist_receiver_data_block_free2(&b);
				}
			}
		}
		else
		{
			// UDP receiver - use epoll/kqueue mechanism  
			evsocket_loop_single(callback_object->evctx, 5, 100);
		}
	}
	return 0;
}

static struct rist_ctx_wrap *configure_rist_output_context(char* outputurl,
	struct rist_peer_args *peer_args, const struct rist_udp_config *udp_config,
	bool npd, enum rist_profile profile)
{
	struct rist_ctx *sender_ctx;
	// Setup the output rist objects (a brand new instance per receiver)
	char *saveptroutput;
	char *tmpoutputurl = malloc(strlen(outputurl) +1);
	strcpy(tmpoutputurl, outputurl);
	char *outputtoken = strtok_r(tmpoutputurl, ",", &saveptroutput);

	// All output peers should be on the same context per receiver
	if (rist_sender_create(&sender_ctx, peer_args->profile, 0, &logging_settings) != 0) {
		rist_log(&logging_settings, RIST_LOG_ERROR, "Could not create rist sender context\n");
		goto fail;
	}
	struct rist_ctx_wrap *w = malloc(sizeof(*w));
	w->ctx = sender_ctx;
	w->id = 0;
	w->sender = true;
	
	// Set auth callbacks
	if (rist_auth_handler_set(sender_ctx, cb_auth_connect, cb_auth_disconnect, w) != 0) {
		rist_log(&logging_settings, RIST_LOG_ERROR, "Could not init rist auth handler\n");
		goto fail;
	}
	
	// Set connection status callback
	if (rist_connection_status_callback_set(sender_ctx, connection_status_callback, w) == -1) {
		rist_log(&logging_settings, RIST_LOG_ERROR, "Could not initialize rist connection status callback\n");
		goto fail;
	}
	
	if (npd) {
		if (profile == RIST_PROFILE_SIMPLE)
			rist_log(&logging_settings, RIST_LOG_INFO, "NULL packet deletion enabled on SIMPLE profile. This is non-compliant but might work if receiver supports it (librist does)\n");
		else
			rist_log(&logging_settings, RIST_LOG_INFO, "NULL packet deletion enabled. Support for this feature is not guaranteed to be present on receivers. Please make sure the receiver supports it (librist does)\n");
		if (rist_sender_npd_enable(sender_ctx) != 0) {
			rist_log(&logging_settings, RIST_LOG_ERROR, "Failed to enable null packet deletion\n");
		}
	}
	
	// Setup peers
	while (outputtoken) {
		peer_args->token = outputtoken;
		peer_args->stream_id = udp_config->stream_id;
		struct rist_peer *peer = setup_rist_peer(w, peer_args);
		if (peer == NULL)
			goto fail;
		outputtoken = strtok_r(NULL, ",", &saveptroutput);
	}
	free(tmpoutputurl);

	return w;
fail:
	free(tmpoutputurl);
	return  NULL;
}

static void print_statistics(struct rist_callback_object *callback_object) {
    rist_log(&logging_settings, RIST_LOG_INFO, 
             "\n=== VSF TR-06-4 Part 7 PROCESSING STATISTICS ===\n");
    rist_log(&logging_settings, RIST_LOG_INFO, 
             "Markers processed: %llu\n", (unsigned long long)callback_object->markers_processed);
    rist_log(&logging_settings, RIST_LOG_INFO, 
             "Blocks validated: %llu\n", (unsigned long long)callback_object->blocks_validated);
    rist_log(&logging_settings, RIST_LOG_INFO, 
             "Blocks dropped: %llu\n", (unsigned long long)callback_object->blocks_dropped);
    rist_log(&logging_settings, RIST_LOG_INFO, 
             "Blocks sent: %llu\n", (unsigned long long)callback_object->blocks_sent);
    rist_log(&logging_settings, RIST_LOG_INFO, 
             "RTP packets sent: %llu\n", (unsigned long long)callback_object->rtp_packets_sent);
    rist_log(&logging_settings, RIST_LOG_INFO, 
             "================================================\n\n");
}

int main(int argc, char *argv[])
{
	int c;
	char *inputurl = NULL;
	char *outputurl = NULL;
	enum rist_profile profile = RIST_PROFILE_MAIN;
	char *shared_secret = NULL;
	int encryption_type = 0;
	int statsinterval = 0;
	int verbosity = RIST_LOG_INFO;
	int buffer_size = 0;
	bool npd = false;

	struct rist_peer_args peer_args;
	memset(&peer_args, 0, sizeof(struct rist_peer_args));
	peer_args.recovery_length_min = 1000;
	peer_args.recovery_length_max = 1000;
	peer_args.recovery_reorder_buffer = 25;
	peer_args.recovery_rtt_min = 50;
	peer_args.recovery_rtt_max = 500;

	for (size_t i = 0; i < MAX_INPUT_COUNT; i++) {
		memset(&callback_object[i], 0, sizeof(callback_object[i]));
	}

	// Command line processing
	struct option long_options[] = {
		{ "help",            no_argument,        NULL, 'h' },
		{ "url",             required_argument,  NULL, 'u' },
		{ "input-url",       required_argument,  NULL, 'i' },
		{ "profile",         required_argument,  NULL, 'p' },
		{ "shared-secret",   required_argument,  NULL, 's' },
		{ "encryption-type", required_argument,  NULL, 'e' },
		{ "stats",           required_argument,  NULL, 'S' },
		{ "verbose-level",   required_argument,  NULL, 'v' },
		{ "buffer",          required_argument,  NULL, 'b' },
		{ "npd",             no_argument,        NULL, 'n' },
		{ 0, 0, 0, 0 },
	};

	while ((c = getopt_long(argc, argv, "hi:u:p:s:e:S:v:b:n", long_options, NULL)) != -1) {
		switch (c) {
		case 'i':
			inputurl = strdup(optarg);
			break;
		case 'u':
			outputurl = strdup(optarg);
			break;
		case 'p':
			profile = (enum rist_profile)atoi(optarg);
			break;
		case 's':
			shared_secret = strdup(optarg);
			break;
		case 'e':
			encryption_type = atoi(optarg);
			break;
		case 'S':
			statsinterval = atoi(optarg);
			break;
		case 'v':
			verbosity = atoi(optarg);
			break;
		case 'b':
			buffer_size = atoi(optarg);
			break;
		case 'n':
			npd = true;
			break;
		case 'h':
		default:
			usage(argv[0]);
		}
	}

	if (!inputurl || !outputurl) {
		usage(argv[0]);
	}

	struct rist_logging_settings *log_ptr = &logging_settings;
	if (rist_logging_set(&log_ptr, verbosity, NULL, NULL, NULL, stderr) != 0) {
		fprintf(stderr, "Failed to setup logging!\n");
		exit(1);
	}

	rist_log(&logging_settings, RIST_LOG_INFO, "VSF TR-06-4 Part 7 RIST Sender (marker stripper) - FIXED VERSION\n");
	rist_log(&logging_settings, RIST_LOG_INFO, "libRIST version: %s API version: %s\n", librist_version(), librist_api_version());
	rist_log(&logging_settings, RIST_LOG_INFO, "Fixed sequence number assignment: using rtp_sequence_start\n");

	signal(SIGINT, intHandler);
	signal(SIGTERM, intHandler);
	signal(SIGPIPE, intHandler);

	peer_args.loglevel = verbosity;
	peer_args.profile = profile;
	peer_args.encryption_type = encryption_type;
	peer_args.shared_secret = shared_secret;
	peer_args.buffer_size = buffer_size;
	peer_args.statsinterval = statsinterval;

	bool rist_listens = false;
	if (strstr(outputurl, "://@") != NULL) {
		rist_listens = true;
	}

	// Setup the input udp/rist objects: listen to the given address(es)
	int32_t stream_id_check[MAX_INPUT_COUNT ];
	for (size_t j = 0; j < MAX_INPUT_COUNT; j++)
		stream_id_check[j] = -1;
	struct evsocket_ctx *evctx = NULL;
	bool atleast_one_socket_opened = false;
	char *saveptrinput;
	char *inputtoken = strtok_r(inputurl, ",", &saveptrinput);
	struct rist_udp_config *udp_config = NULL;
	for (size_t i = 0; i < MAX_INPUT_COUNT; i++) {
		if (!inputtoken)
			break;

		// First parse extra url and parameters
		if (rist_parse_udp_address2(inputtoken, &udp_config)) {
			rist_log(&logging_settings, RIST_LOG_ERROR, "Could not parse inputurl %s\n", inputtoken);
			goto next;
		}

		// Check for duplicate stream-ids and reject the entire config if we have any dups
		bool found_empty = false;
		for (size_t j = 0; j < MAX_INPUT_COUNT; j++) {
			if (stream_id_check[j] == -1 && !found_empty) {
				stream_id_check[j] = (int32_t)udp_config->stream_id;
				rist_log(&logging_settings, RIST_LOG_INFO, "Assigning stream-id %d to this input\n", udp_config->stream_id);
				found_empty = true;
			} else if ((uint16_t)stream_id_check[j] == udp_config->stream_id) {
				rist_log(&logging_settings, RIST_LOG_ERROR, "Every input must have a unique stream-id (%d) when you multiplex\n", udp_config->stream_id);
				goto shutdown;
			}
		}

		// Setup the output rist objects
		if (rist_listens && i > 0) {
			// Single context for all inputs, we multiplex on the payload
			callback_object[i].sender_ctx = callback_object[0].sender_ctx;
		}
		else
		{
			// A brand new instance/context per receiver
			callback_object[i].sender_ctx = configure_rist_output_context(outputurl, &peer_args, udp_config, npd, profile);
			if (callback_object[i].sender_ctx == NULL)
				goto shutdown;
		}

		if (strcmp(udp_config->prefix, "rist") == 0) {
			// This is a rist input (new context for each listener)
			struct rist_ctx_wrap *w = calloc(1, sizeof(*w));
			w->id = 0;
			callback_object[i].receiver_ctx = w;
			if (rist_receiver_create(&callback_object[i].receiver_ctx->ctx, peer_args.profile, &logging_settings) != 0) {
				rist_log(&logging_settings, RIST_LOG_ERROR, "Could not create rist receiver context\n");
				goto next;
			}
			peer_args.token = inputtoken;
			struct rist_peer *peer = setup_rist_peer(callback_object[i].receiver_ctx, &peer_args);
			if (peer == NULL)
				atleast_one_socket_opened = true;
			rist_udp_config_free2(&udp_config);
			udp_config = NULL;
		}
		else {
			// Allocate block buffer for Part 7 processing
			callback_object[i].block_buffer_capacity = MAX_BLOCK_TS_PACKETS * TS_PACKET_SIZE;
			callback_object[i].block_buffer = malloc(callback_object[i].block_buffer_capacity);
			if (!callback_object[i].block_buffer) {
				rist_log(&logging_settings, RIST_LOG_ERROR, "Failed to allocate block buffer\n");
				goto shutdown;
			}
			rist_log(&logging_settings, RIST_LOG_INFO, 
			         "Allocated block buffer: %zu TS packets (%zu bytes)\n",
			         MAX_BLOCK_TS_PACKETS, callback_object[i].block_buffer_capacity);
			
			if(!evctx)
				evctx = evsocket_create();
			// This is a udp input, i.e. 127.0.0.1:5000
			char hostname[200] = {0};
			int inputlisten;
			uint16_t inputport;
			if (udpsocket_parse_url((void *)udp_config->address, hostname, 200, &inputport, &inputlisten) || !inputport || strlen(hostname) == 0) {
				rist_log(&logging_settings, RIST_LOG_ERROR, "Could not parse input url %s\n", inputtoken);
				goto next;
			}
			rist_log(&logging_settings, RIST_LOG_INFO, "URL parsed successfully: Host %s, Port %d\n", (char *) hostname, inputport);

			callback_object[i].sd = udpsocket_open_bind(hostname, inputport, udp_config->miface);
			if (callback_object[i].sd < 0) {
				rist_log(&logging_settings, RIST_LOG_ERROR, "Could not bind to: Host %s, Port %d, miface %s.\n",
					(char *) hostname, inputport, udp_config->miface);
				goto next;
			} else {
				udpsocket_set_nonblocking(callback_object[i].sd);
				rist_log(&logging_settings, RIST_LOG_INFO, "Input socket is open and bound %s:%d\n", (char *) hostname, inputport);
				atleast_one_socket_opened = true;
			}
			callback_object[i].udp_config = udp_config;
			udp_config = NULL;
			callback_object[i].evctx = evctx;
			event[i] = evsocket_addevent(callback_object[i].evctx, callback_object[i].sd, EVSOCKET_EV_READ, input_udp_recv, input_udp_sockerr,
				(void *)&callback_object[i]);
		}

next:
		inputtoken = strtok_r(NULL, ",", &saveptrinput);
	}

 	if (!atleast_one_socket_opened) {
 		goto shutdown;
 	}

	if (evctx && pthread_create(&thread_main_loop[0], NULL, input_loop, (void *)callback_object) != 0)
	{
		rist_log(&logging_settings, RIST_LOG_ERROR, "Could not start udp receiver thread\n");
		goto shutdown;
	}
	thread_started[0] = true;

	for (size_t i = 0; i < MAX_INPUT_COUNT; i++) {
		if (((rist_listens && i == 0) || !rist_listens) &&
			 callback_object[i].sender_ctx) {
			// Don't start sender here - it will be started when first marker is received
			rist_log(&logging_settings, RIST_LOG_INFO, 
			         "Sender context created, waiting for first marker to start...\n");
		}
		if (callback_object[i].receiver_ctx && rist_start(callback_object[i].receiver_ctx->ctx) == -1) {
			rist_log(&logging_settings, RIST_LOG_ERROR, "Could not start rist receiver\n");
			goto shutdown;
		}
		if (callback_object[i].receiver_ctx && pthread_create(&thread_main_loop[i+1], NULL, input_loop, (void *)&callback_object[i]) != 0)
		{
			rist_log(&logging_settings, RIST_LOG_ERROR, "Could not start send rist receiver thread\n");
			goto shutdown;
		} else if (callback_object[i].receiver_ctx) {
			thread_started[i+1] = true;
		}
	}

	rist_log(&logging_settings, RIST_LOG_INFO, "VSF TR-06-4 Part 7 sender started successfully\n");
	rist_log(&logging_settings, RIST_LOG_INFO, "Waiting for first marker to begin processing...\n");

#ifndef _WIN32
	pause();
#endif

shutdown:
	// Print statistics before shutdown
	for (size_t i = 0; i < MAX_INPUT_COUNT; i++) {
		if (callback_object[i].markers_processed > 0) {
			print_statistics(&callback_object[i]);
		}
	}

	if (udp_config) {
		rist_udp_config_free2(&udp_config);
	}
	for (size_t i = 0; i < MAX_INPUT_COUNT; i++) {
		// Remove socket events
		if (event[i])
			evsocket_delevent(callback_object[i].evctx, event[i]);
		// Free block buffer
		if (callback_object[i].block_buffer)
			free(callback_object[i].block_buffer);
		// Free udp_config object
		if ((void *)callback_object[i].udp_config)
			rist_udp_config_free2(&callback_object[i].udp_config);
		// Cleanup rist listeners
		if (callback_object[i].receiver_ctx) {
			rist_destroy(callback_object[i].receiver_ctx->ctx);
			free(callback_object[i].receiver_ctx);
		}
		// Cleanup rist sender and their peers
		if (callback_object[i].sender_ctx) {
			rist_destroy(callback_object[i].sender_ctx->ctx);
			free(callback_object[i].sender_ctx);
		}
	}

	for (size_t i = 0; i <= MAX_INPUT_COUNT; i++) {
		if (thread_started[i])
			pthread_join(thread_main_loop[i], NULL);
	}

	rist_logging_unset_global();
	if (inputurl)
		free(inputurl);
	if (outputurl)
		free(outputurl);
	if (shared_secret)
		free(shared_secret);

	return 0;
}